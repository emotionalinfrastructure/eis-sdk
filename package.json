{
  "name": "eis-sdk",
  "version": "1.0.1",
  "description": "Emotional Infrastructure™ SDK – consent lifecycle, cryptographic CTID v1.2, audit logs, tolerance windows, and trust repair analytics.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist coverage docs-build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --coverage",
    "coverage": "jest --coverage",
    "smoke": "npm run smoke:esm && npm run smoke:cjs",
    "smoke:esm": "node examples/smoke-esm.mjs",
    "smoke:cjs": "node examples/smoke-cjs.cjs",
    "validate": "./scripts/run-all-tests.sh",
    "prepublishOnly": "npm run validate",
    "docs": "typedoc --out docs src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Emotional-Infrastructure/eis-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Emotional-Infrastructure/eis-sdk/issues"
  },
  "homepage": "https://github.com/Emotional-Infrastructure/eis-sdk#readme",
  "author": "Brittany Wright",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.17",
    "@types/react": "^18.3.27",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-plugin-jest": "^27.6.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.1",
    "typedoc": "^0.25.13",
    "typescript": "^5.3.3"
  }
}
